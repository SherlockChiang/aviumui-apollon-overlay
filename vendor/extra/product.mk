# Local AviumUI 16.2 build overlay for Xiaomi Mi 10T / Mi 10T Pro.
# Keep the LineageOS 23.2 device tree untouched and select Avium's GMS bundle.
WITH_GMS := true
AVIUM_MAINTAINER := vince
AVIUM_SETTINGS_SOC_MODEL_NAME := Qualcomm Snapdragon 865
AVIUM_SETTINGS_DEVICE_CODENAME := apollon
